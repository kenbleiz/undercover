# Hostname served by nginx (self-signed cert CN / Let's Encrypt domain)
DOMAIN=localhost

# Optional extra SANs for the self-signed cert (comma-separated)
# TLS_SAN=DNS:undercover.local,IP:192.168.1.20

# Postgres (change this)
POSTGRES_PASSWORD=undercover

# Let's Encrypt — only with: docker compose --profile le up
# EMAIL=you@example.com
